// The things in the basement.
//   enemy "id" name="Shown name" hp=<health> r=<radius, u> touch=<hearts lost on contact> paint="--token" shape="fly|head|lump|blob" {
//       enemy words, one per line: how it moves and attacks, then what it drops when killed
//   }
// `paint` is a palette token in src/screens/shared.css :root; `shape` is its body (src/view/scene.ts).
// Enemy words (src/enemies.ts, catalog ## Behaviour words); speeds in u/s, the kid runs at 7:
//   chase speed                   go straight for the kid
//   orbit range_u speed           keep about range_u away and circle
//   lunge every_s speed           every few seconds: stop, shake, then charge at the kid
//   shoot every_s speed           every few seconds: one shot at the kid
//   spray n every_s speed         every few seconds: n shots in a ring
// Drop words (src/rewards.ts):
//   pennies n                     n pennies to spend in the shop (and n towards the run's score)
//   heal n                        n hearts back

// Fast, fragile, comes in swarms. Buzz.
enemy "fly" name="Fly" hp=2 r=0.4 touch=1 paint="--enemy-fly" shape="fly" {
    chase 3.6
    pennies 10
}

// A floating head that cries blood at you from a distance. Get close, or knock a tooth through it.
enemy "weeper" name="Weeper" hp=3 r=0.45 touch=1 paint="--enemy-weeper" shape="head" {
    orbit 7 2.0
    shoot 2.6 7
    pennies 20
}

// A pink lump that waddles, then stops and squeals: that's your cue to move before it charges.
enemy "squealer" name="Squealer" hp=5 r=0.55 touch=2 paint="--enemy-squealer" shape="lump" {
    chase 1.6
    lunge 3.2 15
    pennies 30
}

// Slow and enormous; heaves rings of bile. Worth everything in your stomach.
enemy "glutton" name="Glutton" hp=18 r=0.95 touch=2 paint="--enemy-glutton" shape="blob" {
    chase 1.1
    spray 10 3.5 5
    pennies 80
    heal 1
}
