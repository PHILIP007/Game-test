// The cards. A run starts with each card's `starting` copies; every card can turn up as a reward after a wave.
//   card "id" name="Shown name" cost=<energy> kind="attack|move|power" paint="--token" starting=<copies> text="..." {
//       card words, run top to bottom when it's played
//   }
// `kind` picks the card's frame colour (screens/shared.css). `paint` is its shots' colour, a palette token in
// src/screens/shared.css :root. In `text`, {volley.0} quotes the first number of the card's own `volley` word.
// Card words (src/cards.ts, catalog ## Behaviour words); aim is towards the cursor:
//   volley n spread_deg damage    n shots fanned across spread_deg
//   rail damage                   one fast slug that goes through everything
//   nova n damage                 n shots in a ring all round you
//   dash dist_u                   jump dist_u along your aim, untouchable for a moment
//   shield s                      a bubble for s seconds: nothing touches you
//   rapid s                       the blaster fires much faster for s seconds
//   charge n                      n energy now
//   mend n                        n health back

// ---------- the starting deck ----------

card "scatter" name="Scatter" cost=1 kind="attack" paint="--card-scatter" starting=3 text="{volley.0} shots in a fan" {
    volley 5 40 1
}

card "rail" name="Rail" cost=2 kind="attack" paint="--card-rail" starting=2 text="A slug through everything: {rail.0} damage" {
    rail 4
}

card "dash" name="Dash" cost=1 kind="move" paint="--card-dash" starting=2 text="Jump {dash.0} towards the cursor" {
    dash 4
}

card "surge" name="Surge" cost=0 kind="power" paint="--card-surge" starting=1 text="+{charge.0} energy" {
    charge 2
}

// ---------- found as rewards ----------

card "nova" name="Nova" cost=3 kind="attack" paint="--card-nova" text="{nova.0} shots all round you" {
    nova 16 2
}

card "barrage" name="Barrage" cost=3 kind="attack" paint="--card-barrage" text="{volley.0} heavy shots in a wide fan" {
    volley 9 80 2
}

card "barrier" name="Barrier" cost=2 kind="power" paint="--card-barrier" text="Untouchable for {shield.0}s" {
    shield 3
}

card "overclock" name="Overclock" cost=2 kind="power" paint="--card-overclock" text="Blaster fires fast for {rapid.0}s" {
    rapid 5
}

card "blink" name="Blink" cost=0 kind="move" paint="--card-blink" text="Jump {dash.0}, +{charge.0} energy" {
    dash 3
    charge 1
}

card "patch" name="Patch" cost=2 kind="power" paint="--card-patch" text="+{mend.0} health" {
    mend 2
}
