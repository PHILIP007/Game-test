// What comes out of the kid's mouth. The kid can have up to 4 things swallowed (STOMACH_SLOTS in src/tuning.ts),
// each on its own cooldown. Whatever sits in slot 1 (AUTO_SLOTS) spits at the cursor by itself whenever its cooldown
// comes round, holding back while the nightmare is empty; the others wait, ready, until you call them (press 2, 3 or
// 4, or click the tile). Whatever you swallow goes in the first empty slot, so cough up the spit and your next
// swallow becomes the automatic one. The shop after each wave offers 3 of these with a price in pennies; coughing
// one up pays back half its price (SELL_BACK).
//   weapon "id" name="Shown name" price=<pennies> cooldown-s=<seconds between uses> kind="attack|defend"
//          paint="--token" starting=<copies swallowed at the start> text="..." {
//       weapon words, run top to bottom each time it's used
//   }
// `kind` picks the tile's frame colour (screens/shared.css). `paint` is its gobs' colour, a palette token in
// src/screens/shared.css :root. In `text`, {volley.0} quotes the first number of its own `volley` word, and
// {cooldown} its cooldown-s.
// Weapon words (src/weapons.ts, catalog ## Behaviour words); aim is towards the cursor:
//   volley n spread_deg damage    n gobs fanned across spread_deg (n 1: one straight gob)
//   pierce damage                 one fast shot that goes through everything
//   nova n damage                 n gobs in a ring all round you
//   shield s                      a bubble for s seconds: nothing touches you
//   mend n                        n hearts back
// Balance by cooldown: an attack's damage per second is its gobs' damage, all told, divided by its cooldown-s.

// ---------- what the kid starts with ----------

weapon "spit" name="Spit" price=0 cooldown-s=0.25 kind="attack" paint="--weapon-spit" starting=1 text="A gob of spit at the cursor" {
    volley 1 0 1
}

// ---------- attacks from the shop ----------

// Cheap, a little better than spit: the first buy after wave 1.
weapon "slobber" name="Slobber" price=50 cooldown-s=0.4 kind="attack" paint="--weapon-slobber" text="{volley.0} gobs side by side" {
    volley 2 10 1
}

// Clears flies close up; slow to bring back up.
weapon "chunks" name="Chunks" price=60 cooldown-s=1.1 kind="attack" paint="--weapon-chunks" text="{volley.0} chunky gobs in a fan" {
    volley 5 40 1
}

// Spit out a tooth: it goes through a whole line of them.
weapon "tooth" name="Loose Tooth" price=80 cooldown-s=1.6 kind="attack" paint="--weapon-tooth" text="A tooth through everything: {pierce.0} damage" {
    pierce 4
}

// Blow a raspberry: spit, but much faster.
weapon "raspberry" name="Raspberry" price=100 cooldown-s=0.12 kind="attack" paint="--weapon-raspberry" text="A spray of tiny gobs" {
    volley 1 0 1
}

// When they come from every side.
weapon "burp" name="Big Burp" price=120 cooldown-s=2.5 kind="attack" paint="--weapon-burp" text="{nova.0} gobs all round you" {
    nova 16 2
}

// The heavy hitter: a wide wall of strong chunks, slowly.
weapon "puke" name="Projectile Puke" price=150 cooldown-s=2.2 kind="attack" paint="--weapon-puke" text="{volley.0} heavy chunks in a wide fan" {
    volley 9 80 2
}

// ---------- defence from the shop ----------

weapon "bubble" name="Spit Bubble" price=100 cooldown-s=9 kind="defend" paint="--weapon-bubble" text="Untouchable for {shield.0}s, every {cooldown}s" {
    shield 2
}

weapon "lick" name="Lick Wounds" price=110 cooldown-s=12 kind="defend" paint="--weapon-lick" text="+{mend.0} heart, every {cooldown}s" {
    mend 1
}
