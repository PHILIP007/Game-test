// The waves, in order. After the last one the list starts again from the top, and every enemy has more health each
// time round (LAP_HP_STEP in src/tuning.ts).
//   wave "id" gap-s=<seconds between spawns> {
//       <enemy id> <how many>     one line per group, in the order they come
//   }
// Enemy ids are the ones in content/enemies.kdl.

wave "something-buzzing" gap-s=1.0 {
    fly 6
}

wave "crying-in-the-dark" gap-s=0.9 {
    fly 4
    weeper 3
    fly 4
}

wave "squealing" gap-s=0.8 {
    squealer 2
    fly 6
    squealer 2
}

wave "wet-crossfire" gap-s=0.7 {
    weeper 4
    fly 8
    squealer 2
}

wave "the-glutton" gap-s=0.9 {
    fly 6
    glutton 1
    weeper 3
}

wave "the-swarm" gap-s=0.35 {
    fly 24
    squealer 3
}

wave "the-deep-basement" gap-s=0.7 {
    glutton 2
    weeper 5
    squealer 4
    fly 10
}
