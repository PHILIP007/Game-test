// The waves, in order. After the last one the list starts again from the top, and every enemy has more health each
// time round (LAP_HP_STEP in src/tuning.ts).
//   wave "id" gap-s=<seconds between spawns> {
//       <enemy id> <how many>     one line per group, in the order they come
//   }
// Enemy ids are the ones in content/enemies.kdl.

wave "the-lights-go-out" gap-s=1.0 {
    mothling 6
}

wave "something-is-watching" gap-s=0.9 {
    mothling 4
    goggler 3
    mothling 4
}

wave "teeth-in-the-dark" gap-s=0.8 {
    gnasher 2
    mothling 6
    gnasher 2
}

wave "they-all-see-you" gap-s=0.7 {
    goggler 4
    mothling 8
    gnasher 2
}

wave "the-sack" gap-s=0.9 {
    mothling 6
    sackmaw 1
    goggler 3
}

wave "wings" gap-s=0.35 {
    mothling 24
    gnasher 3
}

wave "the-bottom-of-the-dream" gap-s=0.7 {
    sackmaw 2
    goggler 5
    gnasher 4
    mothling 10
}
