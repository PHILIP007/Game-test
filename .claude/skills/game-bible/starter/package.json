{
  "name": "my-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "build": "tsc && vite build",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "typecheck": "tsc",
    "sim": "node scripts/run.mjs scripts/sim.ts",
    "shots": "node scripts/shots.mjs",
    "models": "node scripts/models.mjs"
  },
  "dependencies": {
    "kdljs": "^0.3.0",
    "pixi.js": "^8.21.0",
    "three": "^0.186.1",
    "yoga-layout": "^3.2.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "@types/three": "^0.186.0",
    "@vitest/browser-playwright": "^5.0.2",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
