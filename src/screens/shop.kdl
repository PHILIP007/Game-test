// The shop after a cleared wave, over the dimmed basement: the title and your pennies; what's on offer, one thing to
// swallow (that starts the next wave); your stomach, anything in which you can cough up first to free a slot or for
// pennies; and a button to move on without buying. Styled with the shared dialog classes (shared.css) and shop.css; bound in shop.ts.
prefab "shop" {
    panel class="dialog" {
        panel class="dialog-scrim"
        text class="shop-title" bind="title"
        text class="shop-pennies" bind="pennies"
        text class="dialog-sub" "SWALLOW ONE  ·  SLOT 1 SPITS BY ITSELF, THE REST WHEN YOU CALL THEM"
        panel class="shop-row" slot="offer"
        text class="dialog-sub" "YOUR STOMACH  ·  TAP ONE TO COUGH IT UP"
        panel class="shop-row" slot="stomach"
        panel class="dialog-buttons" slot="buttons"
    }
}
