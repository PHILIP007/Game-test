// Shared prefabs, prepended to every screen's KDL by screenUi (shared.ts); styled in shared.css. Build them with the
// binding builders in shared.ts. Elements, attributes and bindings: docs/declarative-ui.md.

// A labelled button: btn(label, tap, state?) in shared.ts. `state` becomes classes (primary, off).
prefab "btn" {
    button bind-class="state" tap="tap" {
        text class="shared-btn-label" bind="label"
    }
}

// A weapon from content/weapons.kdl: weapon(id, tap, { key, tag, charge, foot, off?, ready? }) in shared.ts. Its kind
// (attack, defend), `off` and `ready` become classes; with no tap (the automatic slot) it can't be pressed.
prefab "weapon" {
    button class="weapon" bind-class="state" tap="tap" {
        panel class="weapon-top" {
            text class="weapon-name" bind="name"
            text class="weapon-tag" bind="tag"
        }
        text class="weapon-text" bind="text"
        panel class="weapon-bar" {
            meter class="weapon-charge" value=(bind)"charge"
        }
        text class="weapon-foot" bind="foot"
    }
}

// A stomach slot with nothing in it, the size of a weapon tile: emptySlot(key) in shared.ts.
prefab "slot-empty" {
    panel class="slot-empty" {
        text class="slot-empty-label" "NOTHING SWALLOWED"
    }
}

// One line of text in a dialog's body: line(text) in shared.ts.
prefab "line" {
    text class="shared-line" bind="text"
}

// A dialog over the dimmed basement: dialog(title, sub, body, buttons, layout?) in shared.ts. It swallows taps, so
// nothing behind it can be pressed. `layout` is the body's class: a column of lines, or a `row` of tiles.
prefab "dialog" {
    panel class="dialog" {
        panel class="dialog-scrim"
        text class="dialog-title" bind="title"
        text class="dialog-sub" bind="sub"
        panel class="dialog-body" bind-class="layout" slot="body"
        panel class="dialog-buttons" slot="buttons"
    }
}
