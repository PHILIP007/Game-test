// The HUD during a run (hidden while the shop is open): hull, wave, points and score along the top; the weapon mounts along the bottom, each filling
// its bar as its cooldown comes round, so the arena shows between. Styled in hud.css; bound in hud.ts.
prefab "hud" {
    panel class="hud" {
        panel class="hud-top" {
            panel class="hud-hull" {
                text class="hud-label" "HULL"
                panel class="hud-bar" {
                    meter class="hud-hull-fill" value=(bind)"hull"
                }
                text class="hud-num" bind="hullText"
            }
            text class="hud-wave" bind="wave"
            panel class="hud-right" {
                text class="hud-points" bind="points"
                text class="hud-score" bind="score"
            }
        }
        panel class="hud-mounts" slot="mounts"
    }
}
