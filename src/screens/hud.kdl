// The HUD during a run (hidden while the shop is open): hearts, wave, pennies and score along the top; what's
// swallowed along the bottom, each filling its bar as its cooldown comes round, so the nightmare shows between. Styled in
// hud.css; bound in hud.ts.
prefab "hud" {
    panel class="hud" {
        panel class="hud-top" {
            panel class="hud-health" {
                hearts class="hud-hearts" value=(bind)"hearts" max=(bind)"maxHearts"
            }
            text class="hud-wave" bind="wave"
            panel class="hud-right" {
                text class="hud-pennies" bind="pennies"
                text class="hud-score" bind="score"
            }
        }
        panel class="hud-slots" slot="slots"
    }
}
