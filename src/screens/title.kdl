// The title screen, over the arena: the game's name and tagline at the top, how to play in the middle, the play
// button and your records at the bottom. Styled in title.css; bound in title.ts.
prefab "title" {
    panel class="title" {
        panel class="title-scrim"
        panel class="title-top" {
            text class="title-name" "DECKFIRE"
            text class="title-tag" "AN ARENA SHOOTER OF MOUNTED GUNS"
        }
        panel class="title-how" {
            text class="title-line" "WASD OR ARROWS TO MOVE  ·  THE MOUSE AIMS  ·  ESC PAUSES"
            text class="title-line" "EVERY WEAPON YOU MOUNT FIRES BY ITSELF, EACH ON ITS OWN COOLDOWN"
            text class="title-line" "KILLS PAY POINTS  ·  AFTER EACH WAVE, BUY A WEAPON OR SELL ONE IN THE SHOP"
        }
        panel class="title-bottom" {
            panel class="title-buttons" slot="buttons"
            text class="title-best" bind="best"
        }
    }
}
